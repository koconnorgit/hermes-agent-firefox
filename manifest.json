{
  "manifest_version": 3,
  "name": "Hermes Agent",
  "version": "0.1.15",
  "description": "Chat with the Nous Research Hermes agent, send page context, and fire quick tasks — from a Firefox sidebar.",

  "browser_specific_settings": {
    "gecko": {
      "id": "hermes-agent-firefox@koconnorgit",
      "strict_min_version": "128.0",
      "update_url": "https://github.com/koconnorgit/hermes-agent-firefox/releases/latest/download/updates.json",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "background": {
    "scripts": ["config.js", "background.js"]
  },

  "sidebar_action": {
    "default_title": "Hermes Agent",
    "default_panel": "sidebar/sidebar.html",
    "default_icon": "icons/hermes.svg"
  },

  "action": {
    "default_title": "Open Hermes",
    "default_icon": "icons/hermes.svg"
  },

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },

  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": { "default": "Ctrl+Shift+Y" }
    }
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "permissions": [
    "storage",
    "menus",
    "activeTab",
    "tabs",
    "notifications",
    "alarms"
  ],

  "optional_host_permissions": [
    "*://*/*"
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http: https: ws: wss:"
  },

  "icons": {
    "48": "icons/hermes.svg",
    "96": "icons/hermes.svg"
  }
}
